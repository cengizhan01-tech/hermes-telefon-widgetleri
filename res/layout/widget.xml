<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_aurora">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OPENROUTER"
            android:textColor="#C4B5FD"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
        <TextView
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙"
            android:textColor="#C4B5FD"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="…"
        android:textColor="#34D399"
        android:textSize="32sp"
        android:textStyle="bold"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6" />

    <TextView
        android:id="@+id/balance_mono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:fontFamily="monospace"
        android:text="…"
        android:textColor="#00F0FF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:shadowColor="#AA00F0FF"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="14" />

    <TextView
        android:id="@+id/caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#E0E7FF"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="9dp"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:progress="500"
        android:progressDrawable="@drawable/bar_bg" />

    <LinearLayout
        android:id="@+id/chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/chip_saat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:background="@drawable/chip_bg" android:padding="5dp" android:gravity="center" android:text="-" android:textColor="#FFFFFF" android:textSize="14sp" />
        <TextView android:id="@+id/chip_gun" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginLeft="4dp" android:background="@drawable/chip_bg" android:padding="5dp" android:gravity="center" android:text="-" android:textColor="#FFFFFF" android:textSize="14sp" />
        <TextView android:id="@+id/chip_hafta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginLeft="4dp" android:background="@drawable/chip_bg" android:padding="5dp" android:gravity="center" android:text="-" android:textColor="#FFFFFF" android:textSize="14sp" />
        <TextView android:id="@+id/chip_ay" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginLeft="4dp" android:background="@drawable/chip_bg" android:padding="5dp" android:gravity="center" android:text="-" android:textColor="#FFFFFF" android:textSize="14sp" />
    </LinearLayout>

    <TextView android:id="@+id/sec_hiz" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="HARCAMA HIZI" android:textColor="#C4B5FD" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.12" />
    <TextView android:id="@+id/hiz" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#E0E7FF" android:textSize="14sp" />
    <TextView android:id="@+id/spark" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="" android:textColor="#34D399" android:textSize="15sp" android:fontFamily="monospace" />

    <TextView android:id="@+id/sec_model" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="AKTİF MODEL (HERMES)" android:textColor="#C4B5FD" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.12" />
    <TextView android:id="@+id/model" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#E0E7FF" android:textSize="14sp" />

    <TextView android:id="@+id/sec_act" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="EN ÇOK KULLANILAN MODELLER" android:textColor="#C4B5FD" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.12" />
    <TextView android:id="@+id/act" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#E0E7FF" android:textSize="14sp" />

    <TextView android:id="@+id/sec_anahtar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="ANAHTAR VE LİMİT" android:textColor="#C4B5FD" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.12" />
    <TextView android:id="@+id/anahtar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#E0E7FF" android:textSize="14sp" />

    <TextView android:id="@+id/sec_hesap" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="HESAP ÖZETİ" android:textColor="#C4B5FD" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.12" />
    <TextView android:id="@+id/hesap" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#E0E7FF" android:textSize="14sp" />

    <TextView
        android:id="@+id/updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:textColor="#A5B4FC"
        android:textSize="14sp" />
</LinearLayout>
